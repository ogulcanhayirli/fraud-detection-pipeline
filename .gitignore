# Data is never committed: the raw files are ~150MB and redistributing the
# Kaggle dataset is not ours to do. See README for the download step.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Credentials - never commit these. AWS IAM downloads access keys as
# <username>_accessKeys.csv, which a literal "aws_credentials.csv" rule misses.
*accessKeys*.csv
*credentials*.csv
credentials
.env
.env.*
!.env.example
.aws/
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store
